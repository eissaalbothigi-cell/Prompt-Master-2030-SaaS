'use client';

import { useState } from 'react';

export default function CoStarBuilder() {
  const [context, setContext] = useState('');
  const [objective, setObjective] = useState('');
  const [style, setStyle] = useState('');
  const [audience, setAudience] = useState('');
  const [response, setResponse] = useState('');
  const [finalPrompt, setFinalPrompt] = useState('');

  const handleGenerate = () => {
    const prompt = `
# السياق (Context):
${context}

# الهدف (Objective):
${objective}

# الأسلوب (Style):
${style}

# الجمهور (Audience):
${audience}

# شكل الإجابة (Response):
${response}
    `;
    setFinalPrompt(prompt);
  };

  return (
    <div className="min-h-screen bg-gray-900 text-white p-6">
      <div className="max-w-3xl mx-auto">
        <h1 className="text-3xl font-bold text-center mb-6 text-purple-400">
          🧠 منشئ البرومبتات - CO-STAR
        </h1>

        <div className="space-y-4">
          <textarea
            className="w-full bg-gray-800 border border-gray-700 rounded-lg p-3 text-white"
            rows={3}
            placeholder="السياق (Context)..."
            value={context}
            onChange={(e) => setContext(e.target.value)}
          />
          <textarea
            className="w-full bg-gray-800 border border-gray-700 rounded-lg p-3 text-white"
            rows={3}
            placeholder="الهدف (Objective)..."
            value={objective}
            onChange={(e) => setObjective(e.target.value)}
          />
          <input
            className="w-full bg-gray-800 border border-gray-700 rounded-lg p-3 text-white"
            placeholder="الأسلوب (Style)..."
            value={style}
            onChange={(e) => setStyle(e.target.value)}
          />
          <input
            className="w-full bg-gray-800 border border-gray-700 rounded-lg p-3 text-white"
            placeholder="الجمهور (Audience)..."
            value={audience}
            onChange={(e) => setAudience(e.target.value)}
          />
          <input
            className="w-full bg-gray-800 border border-gray-700 rounded-lg p-3 text-white"
            placeholder="شكل الإجابة (Response)..."
            value={response}
            onChange={(e) => setResponse(e.target.value)}
          />
        </div>

        <button
          onClick={handleGenerate}
          className="w-full mt-6 bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-lg transition"
        >
          🚀 توليد البرومبت
        </button>

        {finalPrompt && (
          <div className="mt-6 p-4 bg-gray-800 border border-purple-500 rounded-lg">
            <h2 className="text-purple-400 font-bold mb-2">البرومبت النهائي:</h2>
            <pre className="whitespace-pre-wrap text-sm bg-gray-900 p-3 rounded border border-gray-700">
              {finalPrompt}
            </pre>
            <button
              onClick={() => navigator.clipboard?.writeText(finalPrompt)}
              className="mt-3 bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded text-sm"
            >
              📋 نسخ النص
            </button>
          </div>
        )}
      </div>
    </div>
  );
}