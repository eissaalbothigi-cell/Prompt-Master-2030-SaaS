# ============================================================
# 🧹 .gitignore - Prompt Master 2030
# ============================================================
# This file lists files and directories that should be ignored by Git.
# It is optimized for Next.js 15, pnpm, Drizzle ORM, Playwright, and Chromatic.

# ============================================================
# 📦 Dependencies
# ============================================================
node_modules/
.pnpm-store/
pnpm-lock.yaml   # optional: keep if you want to track lockfile (recommended to keep)

# ============================================================
# 🚀 Next.js
# ============================================================
.next/
out/
dist/
build/
.vercel/
*.tsbuildinfo
.next/standalone/
.next/server/

# ============================================================
# 🌐 Environment Variables
# ============================================================
.env
.env.local
.env.production
.env.development
.env.test
.env.*.local
.env.example

# ============================================================
# 🗄️ Database & Migrations
# ============================================================
migrations/
*.sql
*.db
*.sqlite
*.sqlite-journal
drizzle/          # إذا كنت تستخدم مجلد drizzle/
drizzle.config.ts # اختياري: احتفظ به إذا كان ملفاً عاماً

# ============================================================
# 🧪 Testing (Playwright & Chromatic)
# ============================================================
test-results/
playwright-report/
playwright/.cache/
__snapshots__/
.chromatic/
*.test.ts
*.spec.ts
*.e2e.ts         # اختياري: احتفظ بها إذا أردت تتبعها
test/coverage/
coverage/
.nyc_output/

# ============================================================
# 🎨 Chromatic
# ============================================================
build-storybook.log
storybook-static/

# ============================================================
# 🛠️ IDE & Editors
# ============================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.pid
*.seed
*.pid.lock

# ============================================================
# 🔒 Security & Keys
# ============================================================
*.pem
*.key
*.crt
*.p12
*.pfx
*.der

# ============================================================
# 📝 Logs
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# 🧩 TypeScript
# ============================================================
*.tsbuildinfo
*.d.ts.map
*.js.map
*.js
!*.d.ts          # استثناء ملفات التعريف (declaration files)
*.d.ts           # لكن تجاهل جميع ملفات d.ts بشكل عام (اختياري)

# ============================================================
# 🧰 Misc
# ============================================================
tmp/
temp/
.cache/
*.tmp
*.temp
*.bak
*.orig
*.rej

# ============================================================
# 🤖 AI & Tools
# ============================================================
.cursor/
.copilot/
.continue/
.gemini/

# ============================================================
# 🔧 OS Specific
# ============================================================
.DS_Store
Thumbs.db
*.dll
*.so
*.dylib
*.exe