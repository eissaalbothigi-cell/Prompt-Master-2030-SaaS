{
  /* eslint-disable jsonc/sort-keys */
  "compilerOptions": {
    // ======================================================================
    // 🧠 Language & Environment (اللغة والبيئة)
    // ======================================================================
    "target": "ES2022",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    "isolatedModules": true,

    // ======================================================================
    // 🛡️ Type Safety - Foundation (الأساسيات)
    // ======================================================================
    "strict": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictFunctionTypes": true,

    // ======================================================================
    // 🔍 Type Safety - Advanced (فحوصات متقدمة)
    // ======================================================================
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,

    // ======================================================================
    // 🔄 Interoperability (التوافق)
    // ======================================================================
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,

    // ======================================================================
    // ⚡ Build & Performance (الأداء والبناء)
    // ======================================================================
    "skipLibCheck": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "noEmit": true,

    // ======================================================================
    // 📂 Project Structure (هيكل المشروع)
    // ======================================================================
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/public/*": ["./public/*"],
      "@/libs/*": ["./src/libs/*"],
      "@/models/*": ["./src/models/*"],
      "@/components/*": ["./src/components/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/types/*": ["./src/types/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/features/*": ["./src/features/*"],
      "@/context/*": ["./src/context/*"],
      "@/services/*": ["./src/services/*"],
      "@/config/*": ["./src/config/*"]
    },

    // ======================================================================
    // ⚛️ Next.js & React (إعدادات الإطار)
    // ======================================================================
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }]
  },

  // ======================================================================
  // 📁 Include & Exclude (تضمين واستبعاد)
  // ======================================================================
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    "drizzle",
    "coverage",
    "storybook-static",
    "playwright-report",
    "test-results",
    "vitest-test-results",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.e2e.ts",
    "**/*.integ.ts"
  ]
}