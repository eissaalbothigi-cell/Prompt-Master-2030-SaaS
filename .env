# ============================================================
# 🚀 Prompt Master 2030 - Environment Variables
# ============================================================
# This file is a template for environment variables.
# Copy this file to .env (for development) or add to Vercel (for production).
# Never commit .env or .env.production to Git!

# ============================================================
# 🌐 Application Identity
# ============================================================
NEXT_PUBLIC_APP_NAME=Prompt Master 2030

# ============================================================
# 🌐 Hosting & App URL
# ============================================================
# Replace with your actual domain (local or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production: https://prompt-master-2030.vercel.app

# ============================================================
# 🗄️ Database (PostgreSQL - Neon or Supabase)
# ============================================================
# Get your database URL from Neon.tech or Supabase.com
# Example: postgresql://username:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ============================================================
# 🔐 Authentication (JWT Secret)
# ============================================================
# Generate a strong secret key (minimum 32 characters)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=

# ============================================================
# 🤖 AI Provider (OpenRouter)
# ============================================================
# Get your API key from: https://openrouter.ai/keys
# Supports Gemini, Llama, GPT-4, and more
OPENROUTER_API_KEY=

# ============================================================
# 🔧 Optional: Custom AI Provider (if not using OpenRouter)
# ============================================================
# AI_PROVIDER=gemini | deepseek | groq | openai
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# ============================================================
# 🧪 Logging & Debug
# ============================================================
# Levels: error | info | debug | warning | trace | fatal
NEXT_PUBLIC_LOGGING_LEVEL=info

# ============================================================
# ⚙️ Next.js & Build Settings
# ============================================================
NODE_ENV=development

# ============================================================
# 🔒 Sensitive Data (NOT to be committed)
# ============================================================
# Database URL for production (add this to Vercel Environment Variables)
# DATABASE_URL=postgresql://user:pass@host:port/db

# JWT Secret for production (add this to Vercel Environment Variables)
# JWT_SECRET=your_super_secret_key_here

# OpenRouter API Key for production (add this to Vercel Environment Variables)
# OPENROUTER_API_KEY=sk-or-xxxxx

# ============================================================
# 📌 Notes
# ============================================================
# 1. Copy this file to .env and fill in your values for local development
# 2. For production, add variables directly to Vercel: Settings → Environment Variables
# 3. Never commit .env, .env.local, or .env.production to Git
# 4. Use .env.example as a reference for your team