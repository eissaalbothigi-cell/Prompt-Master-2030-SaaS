# ===================================================================
#              PROMPT MASTER 2030 - ENVIRONMENT VARIABLES
#                     (الإصدار العالمي المتكامل)
# ===================================================================
# ⚠️  تحذير أمني: هذا الملف يحتوي على أسرار المنصة.
# ❌  لا ترفعه أبداً إلى GitHub أو أي مستودع عام.
# ✅  استخدم `.env.example` كقالب للمستودع العام.
# ===================================================================

# ----------------------------------------------
# 1. قاعدة البيانات (Neon.tech - PostgreSQL)
# ----------------------------------------------
# احصل على هذا الرابط من لوحة تحكم Neon.tech:
# -> Connection Details -> Pooled Connection
# تأكد من استخدام `?sslmode=require` للتشفير.
DATABASE_URL="postgresql://username:password@ep-cool-frog-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------
# 2. أمان الجلسات (JWT)
# ----------------------------------------------
# يُستخدم لتوقيع توكنات المصادقة.
# لتوليد مفتاح آمن، افتح الطرفية وأكتب:
# > openssl rand -base64 32
JWT_SECRET="WnZkMkYwYVc5dVpXTnZibUYwYVc5dS5hYmNkZWZnaGlqa2xtbm9wcXJzdHV2d3h5ejA="

# ----------------------------------------------
# 3. الذكاء الاصطناعي (OpenRouter)
# ----------------------------------------------
# احصل على مفتاح API من: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-abcdef1234567890ghijklmnopqrstuvwxyz"

# ----------------------------------------------
# 4. التخزين المؤقت وتحديد المعدل (Upstash Redis)
# ----------------------------------------------
# (اختياري لكن مُوصى به بشدة للإنتاج)
# احصل على الرابط والتوكن من لوحة تحكم Upstash:
# -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL="https://your-account.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-super-secret-token"

# ----------------------------------------------
# 5. إعدادات المنصة العامة
# ----------------------------------------------
# رابط التطبيق (يُستخدم في CORS وإعادة التوجيه)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# اسم التطبيق (يظهر في العناوين والأكواد)
NEXT_PUBLIC_APP_NAME="Prompt Master 2030"

# ----------------------------------------------
# 6. البيئة (Environment)
# ----------------------------------------------
# القيم: development | production | test
NODE_ENV="development"

# ----------------------------------------------
# 7. (اختياري) خدمات إضافية
# ----------------------------------------------
# للدفع (Stripe) - عند التفعيل المستقبلي
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# للتحليلات (Sentry) - عند التفعيل المستقبلي
# SENTRY_DSN="https://..."